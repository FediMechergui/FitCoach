# Dependencies
node_modules/

# Expo
.expo/
dist/
# Local APKs (npm run build:apk:local)
/builds/
web-build/
expo-env.d.ts

# Native projects are generated by EAS prebuild (managed workflow) — never commit.
# Root-anchored on purpose: an unanchored `android/` also matches
# modules/*/android/, which would silently exclude local native modules' sources
# from git — and then EAS builds a module with no implementation.
/android/
/ios/
# ...but a local module's BUILD output is generated (its sources above must stay committed).
/modules/*/android/build/
/modules/*/android/.cxx/

# Native
*.orig.*
# EAS signing credentials downloaded for a local build — the keystore and its
# passwords. Never commit: the repository is public.
credentials.json
/credentials/
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# Debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store

# Env
.env*.local

# Drizzle generated migrations (optional to commit)
# drizzle/

# Graphify generated knowledge graph (regenerate with /graphify .)
graphify-out/

# generated-data caches
scripts/.cache/

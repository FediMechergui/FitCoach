<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="#101C25">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="FitCoach" android:textColor="#7CE6B4" android:textSize="20sp" android:textStyle="bold"/>
  <TextView android:id="@+id/widget_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="15sp" android:maxLines="2"/>
  <TextView android:id="@+id/widget_updated" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#B1BFCA" android:textSize="11sp"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
    <Button android:id="@+id/widget_train" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="Train" android:contentDescription="Open FitCoach training"/>
    <Button android:id="@+id/widget_walk" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="Walk" android:contentDescription="Open FitCoach walk tracking"/>
  </LinearLayout>
</LinearLayout>

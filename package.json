{
  "name": "fitcoach",
  "version": "4.0.0",
  "main": "index.ts",
  "scripts": {
    "postinstall": "node scripts/patch-build-tools.cjs",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "verify:engines": "tsx scripts/verify-engines.ts",
    "db:generate": "drizzle-kit generate",
    "build:apk": "eas build -p android --profile preview",
    "build:apk:local": "node scripts/build-apk.js",
    "build:aab": "eas build -p android --profile production",
    "update:push": "node scripts/release.js",
    "release": "node scripts/release.js",
    "verify:repositories": "node scripts/verify-repositories.cjs",
    "verify:upgrade": "node scripts/verify-upgrade.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "~14.0.4",
    "@noble/ciphers": "^1.3.0",
    "@noble/hashes": "^1.8.0",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "base64-js": "^1.5.1",
    "drizzle-orm": "^0.45.4",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-background-fetch": "~13.0.5",
    "expo-constants": "~17.0.5",
    "expo-crypto": "~14.0.2",
    "expo-file-system": "~18.0.12",
    "expo-font": "~13.0.4",
    "expo-image-picker": "~16.0.6",
    "expo-location": "~18.0.5",
    "expo-media-library": "~17.0.6",
    "expo-notifications": "~0.29.13",
    "expo-print": "~14.0.3",
    "expo-secure-store": "~14.0.1",
    "expo-sensors": "~14.0.2",
    "expo-sharing": "~13.0.1",
    "expo-sqlite": "~15.1.4",
    "expo-status-bar": "~2.0.1",
    "expo-system-ui": "~4.0.9",
    "expo-task-manager": "~12.0.5",
    "expo-updates": "~0.27.5",
    "fflate": "^0.8.3",
    "jpeg-js": "^0.4.4",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-body-highlighter": "^3.2.0",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-view-shot": "~4.0.3",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/react": "~18.3.12",
    "babel-plugin-module-resolver": "^5.0.2",
    "drizzle-kit": "^0.30.1",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tsx": "^4.19.2",
    "typescript": "~5.3.3",
    "typescript-eslint": "^8.72.2"
  },
  "private": true,
  "overrides": {
    "expo": "$expo",
    "react": "$react",
    "react-native": "$react-native",
    "tar": "^7.5.23",
    "postcss": "^8.5.33",
    "@xmldom/xmldom": "^0.9.12",
    "react-native-body-highlighter": {
      "react-native-svg": "$react-native-svg"
    }
  }
}
